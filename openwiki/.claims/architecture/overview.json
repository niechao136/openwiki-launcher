    {
      "id": "claim_daf71ade027a4879a29dd26382180b81",
      "statement": "openwiki-launcher 的核心架构是「清单快照 + 后台按需启动」：宿主发来的 initialize 与 tools/list 由内置 manifest 快照即时应答而不触碰后端，tools/call 才排队等待真实 openwiki 后端就绪后透传。",
      "evidence": [
        {
          "resource": "repo://src/broker.mjs#L228-L249",
          "version": "repo-lines-v1:sha256:44c22faf51ab24f83d326b9be42c22e40359dac60d19db9e2fc1fd9001e670ef:"
        },
        {
